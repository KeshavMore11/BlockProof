  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.0",
    "ipfs-http-client": "^60.0.1",
    "qrcode": "^1.5.3"
  }
}
